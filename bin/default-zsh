#!/bin/sh
# default-zsh — make zsh the default shell for all new sessions.
#
# Writes the state file read by the login-shell shim, refreshes the GUI
# session SHELL (macOS), then replaces this process with zsh so the
# current session switches too.

set -e

path=$(command -v zsh) || {
  echo "default-zsh: zsh not found in PATH" >&2
  exit 1
}

STATE_DIR="$HOME/.config/default-shell"
mkdir -p "$STATE_DIR"
echo zsh > "$STATE_DIR/current"

# Apps that read SHELL from the launchd environment (Electron apps like
# Orca) only see this after their next launch.
if command -v launchctl >/dev/null 2>&1; then
  launchctl setenv SHELL "$path"
fi

echo "🐚 default shell -> zsh ($path)"
echo "   new sessions follow immediately; restart running GUI apps to pick it up"
export SHELL="$path"
exec "$path" -l
